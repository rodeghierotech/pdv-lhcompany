# ===== API (apps/api) =====
NODE_ENV=development
PORT=3333
# Neon: use a connection string "pooled" para a API e a "direct" para migrations, se preferir.
DATABASE_URL=postgres://pdv:pdv_dev@localhost:5432/pdv_dev
# Opcional: conexão direta usada apenas por db:migrate (padrão: DATABASE_URL)
DATABASE_URL_MIGRATIONS=
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-gerado-aleatoriamente
ACCESS_TOKEN_TTL=8h
# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Criação do primeiro administrador (script create-admin). Nunca versionar valores reais.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Nuvemshop (fase 9) — o token de acesso vem do OAuth e é guardado CIFRADO no banco; nunca aqui =====
NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_SECRET=
# Opcionais (padrões entre parênteses)
# NUVEMSHOP_API_BASE=https://api.nuvemshop.com.br/2025-03
# NUVEMSHOP_AUTH_BASE=https://www.nuvemshop.com.br
# NUVEMSHOP_USER_AGENT=PDV LH Company (contato@seudominio)
# URL pública da API (webhooks) e do front (retorno do OAuth)
PUBLIC_API_URL=
WEB_URL=
# Chave de cifragem das credenciais (>=32 chars); se vazia, deriva de JWT_SECRET
INTEGRATION_ENCRYPTION_KEY=
# Worker: intervalo do ciclo (ms) e da reconciliação (min)
# WORKER_INTERVAL_MS=5000
# RECONCILE_INTERVAL_MIN=30

# ===== Web (apps/web) =====
VITE_API_URL=http://localhost:3333
VITE_STORE_NAME=LH Company
