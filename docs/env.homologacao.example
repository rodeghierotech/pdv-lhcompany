# Homologação Nuvemshop — copie para `.env.homologacao` na raiz (ignorado pelo git: padrão `.env.*`) e preencha.
# NUNCA cole o client_secret em chat, commit ou log.

# Banco de TESTE (Neon branch ou PostgreSQL local descartável)
DATABASE_URL=
# >= 32 caracteres aleatórios (ex.: openssl rand -hex 32)
JWT_SECRET=
# >= 32 caracteres aleatórios; guarde: trocar invalida o token salvo
INTEGRATION_ENCRYPTION_KEY=

NODE_ENV=production
PORT=3333
# URL pública HTTPS da API (túnel/deploy de teste) e do front
PUBLIC_API_URL=
WEB_URL=
CORS_ORIGINS=

# App Nuvemshop de TESTE
NUVEMSHOP_APP_ID=53513
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_USER_AGENT=PDV LH Company (seu-email@dominio)

# Só durante a homologação (padrão 30)
RECONCILE_INTERVAL_MIN=5
