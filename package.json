{
  "name": "pdv-lh-company",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PDV offline-first da LH Company — base reutilizável da Rodeghiero Tech",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @pdv/api dev",
    "dev:web": "pnpm --filter @pdv/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @pdv/e2e e2e",
    "db:migrate": "pnpm --filter @pdv/api db:migrate",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
